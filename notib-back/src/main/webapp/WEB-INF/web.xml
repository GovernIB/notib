	<login-config>
		<auth-method>KEYCLOAK</auth-method>
		<realm-name>Govern de les Illes Balears</realm-name>
	</login-config>

	<security-role>
		<role-name>NOT_SUPER</role-name>
	</security-role>
	<security-role>
		<role-name>NOT_ADMIN</role-name>
	</security-role>
	<security-role>
		<role-name>NOT_CARPETA</role-name>
	</security-role>
	<security-role>
		<role-name>NOT_APL</role-name>
	</security-role>
	<security-role>
		<role-name>NOT_COM</role-name>
	</security-role>

	<security-constraint>
		<display-name>Unauthenticated areas</display-name>
		<web-resource-collection>
			<web-resource-name>Public areas</web-resource-name>
			<url-pattern>/ws/adviserWs</url-pattern>
			<url-pattern>/ws/notificacioWS</url-pattern>
			<url-pattern>/ws/notificacioV2WS</url-pattern>
			<url-pattern>/swagger-resources/*</url-pattern>
			<url-pattern>/swagger-ui/*</url-pattern>
			<url-pattern>/api/rest</url-pattern>
			<url-pattern>/api/rest/notificaCanvi</url-pattern>
			<url-pattern>/api/apidoc</url-pattern>
			<url-pattern>/api-docs</url-pattern>
			<url-pattern>/api-docs/*</url-pattern>
			<url-pattern>/js/*</url-pattern>
			<url-pattern>/css/*</url-pattern>
			<url-pattern>/img/*</url-pattern>
			<url-pattern>/webjars/*</url-pattern>
			<url-pattern>/images/*</url-pattern>
		</web-resource-collection>
		<!-- Fitxers estàtics de la interfície REACT (JS/CSS compilats, imatges i icona de la pestanya):
		     no contenen dades. Si els protegís el contenidor, amb la sessió caducada cadascun rebria una
		     redirecció al login i sobreescriuria la galeta d'estat OAuth_Token_Request_State (path "/")
		     mentre la pàgina torna de Keycloak: l'estat no quadra i l'adaptador respon 400 Bad Request
		     (reproduït a RIPEA el 30/10/2026 amb el favicon). La pàgina continua protegida i és l'única
		     que fa el login. -->
		<web-resource-collection>
			<web-resource-name>Fitxers estàtics REACT</web-resource-name>
			<url-pattern>/reactapp/assets/*</url-pattern>
			<url-pattern>/reactapp/favicon.png</url-pattern>
			<url-pattern>/reactapp/favicon.svg</url-pattern>
		</web-resource-collection>
		<!-- L'API de la interfície REACT no la protegeix el contenidor: una petició AJAX sense sessió
		     rebria una redirecció al login de Keycloak en lloc d'un 401, i cada redirecció sobreescriuria
		     la galeta OAuth_Token_Request_State (compartida amb les altres aplicacions del servidor).
		     Ho fa Spring Security, que exigeix usuari autenticat a tot /apinew/* excepte l'índex i
		     respon 401 (veure WebSecurityConfig). La interfície REACT s'autentica amb la galeta de la
		     sessió HTTP (veure NotibAuthProvider i SessioUsuariController). -->
		<web-resource-collection>
			<web-resource-name>API REACT</web-resource-name>
			<url-pattern>/apinew</url-pattern>
			<url-pattern>/apinew/*</url-pattern>
		</web-resource-collection>
	</security-constraint>

	<security-constraint>
		<display-name>All areas</display-name>
		<web-resource-collection>
			<web-resource-name>All areas</web-resource-name>
			<url-pattern>/*</url-pattern>
		</web-resource-collection>
		<auth-constraint>
			<role-name>**</role-name>
		</auth-constraint>
	</security-constraint>

	<!-- La galeta de sessió és HttpOnly: cap JavaScript de l'aplicació (JSP ni REACT) llegeix el
	     JSESSIONID, i així un XSS no la pot robar. SameSite=Lax queda pendent fins que s'actualitzi el
	     servidor d'aplicacions (JBoss EAP 7.2 no ho permet des del web.xml). -->
	<session-config>
		<cookie-config>
			<http-only>true</http-only>
		</cookie-config>
	</session-config>

</web-app>
